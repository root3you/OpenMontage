/* bold_offer: dark, high-contrast, uppercase, block wipes */
.k-fill { position: absolute; inset: 0; background: var(--bg); }
.k-photo { position: absolute; overflow: hidden; background: var(--surface); }
.k-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
.k-shade { position: absolute; left: 0; right: 0; bottom: 0; height: 65%; background: linear-gradient(0deg, {{ shade }} 0%, rgba(0,0,0,0) 100%); }
.k-over { {{ roles.over }} color: var(--c-over, var(--accent)); white-space: nowrap; margin: 0; }
.k-head { {{ roles.head }} color: var(--c-head, var(--ink)); white-space: nowrap; margin: 0; }
.k-big { {{ roles.big }} color: var(--c-head, var(--ink)); white-space: nowrap; margin: 0; }
.k-sub { {{ roles.sub }} color: var(--c-sub, var(--muted)); white-space: nowrap; margin: 0; }
.k-item { {{ roles.item }} white-space: nowrap; }
.k-pilltext { {{ roles.pill }} white-space: nowrap; }
.k-mark { {{ roles.mark }} color: var(--ink); white-space: nowrap; }
.k-card { position: absolute; z-index: 10; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; background: var(--accent); border-radius: {{ radius }}px; --c-over: var(--accent-ink); --c-head: var(--accent-ink); --c-sub: var(--accent-ink); box-shadow: 0 18px 0 rgba(0,0,0,.35); }
.k-col { position: absolute; display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
.k-center { position: absolute; left: {{ F.pad_x }}px; top: {{ F.pad_top }}px; width: {{ F.content_w }}px; height: {{ F.safe_h }}px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px; text-align: center; }
.k-rule { display: block; width: 180px; height: 14px; background: var(--c-over, var(--accent)); transform-origin: 0 50%; }
.k-chip { display: block; border-radius: {{ radius }}px; padding: 16px 30px; background: var(--accent); color: var(--accent-ink); }
.k-num { display: flex; align-items: center; justify-content: center; flex: none; border-radius: {{ radius }}px; background: var(--accent); color: var(--accent-ink); font-family: "Archivo Black", sans-serif; font-weight: 400; }
.k-pill { display: block; border-radius: {{ radius }}px; padding: 22px 48px; background: var(--accent); color: var(--accent-ink); }
.k-tag { position: absolute; border-radius: {{ radius }}px; padding: 14px 28px; background: var(--accent); color: var(--accent-ink); }
.k-decor { position: absolute; background: repeating-linear-gradient(135deg, {{ decor }} 0 26px, rgba(0,0,0,0) 26px 64px); }
.k-bars { position: absolute; inset: 0; display: flex; flex-direction: column; z-index: 40; }
.k-bar { flex: 1 1 0; background: var(--accent); }
.k-bars-in .k-bar, .k-cover .k-bar { transform-origin: 50% 0%; }
.k-bars-out .k-bar { transform-origin: 50% 100%; }
.k-cover { position: absolute; z-index: 5; overflow: hidden; }
.k-blocks { position: absolute; inset: 0; overflow: hidden; z-index: 40; }
.k-cover .k-block-a, .k-cover .k-block-b, .k-blocks .k-block-a, .k-blocks .k-block-b { position: absolute; inset: 0; }
.k-block-a { background: var(--accent); }
.k-block-b { background: var(--bg); }
