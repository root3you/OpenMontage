<!doctype html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width={{ F.w }}, height={{ F.h }}">
<title>{{ title }}</title>
<script src="assets/vendor/gsap.min.js"></script>
<style>
html, body { margin: 0; padding: 0; background: {{ bg }}; }
#root { position: relative; width: {{ F.w }}px; height: {{ F.h }}px; overflow: hidden; background: {{ bg }}; }
</style>
</head>
<body>
<div id="root" data-composition-id="main" data-start="0" data-duration="{{ total }}" data-width="{{ F.w }}" data-height="{{ F.h }}">
{% for h in hosts %}
<div id="{{ h.id }}" data-composition-id="{{ h.id }}" data-composition-src="compositions/{{ h.id }}.html" data-start="{{ h.start }}" data-duration="{{ h.duration }}" data-track-index="{{ h.track }}" data-track-kind="graphics" data-width="{{ F.w }}" data-height="{{ F.h }}"></div>
{% endfor %}
{% if narration %}
<audio id="narration" src="{{ narration }}" data-start="0" data-duration="{{ total }}" data-track-index="3" data-volume="1"></audio>
{% endif %}
</div>
<script>
window.__timelines = window.__timelines || {};
window.__timelines["main"] = gsap.timeline({ paused: true });
</script>
</body>
</html>
